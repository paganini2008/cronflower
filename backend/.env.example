# Cronflower backend configuration. Copy to `backend/.env` and fill in. Spring imports this file as
# properties (see cronflow-server-api application.properties: spring.config.import), so every line is a
# plain KEY=value: no quotes, no `export`, and `#` starts a comment. Real OS environment variables
# override anything set here. backend/.env is gitignored; this .example is tracked.
#
# The frontend has its own frontend/.env (copy of frontend/.env.example); the two are separate.

# ============================================================================================
# Database. The app defaults to an embedded H2 file, so you can leave these unset for local dev.
# Set them (and activate the prod profile) to point at a shared MySQL or PostgreSQL.
# ============================================================================================
# CRONFLOW_DB_URL=jdbc:mysql://localhost:3306/cronflow?useSSL=false&serverTimezone=UTC&characterEncoding=utf8&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
# CRONFLOW_DB_USERNAME=root
# CRONFLOW_DB_PASSWORD=

# ============================================================================================
# Security. The JWT signing secret MUST be identical on every node and overridden in production.
# Leave unset for local dev (a dev default is baked in). Use one long random value in prod.
# ============================================================================================
# CRONFLOW_JWT_SECRET=change-me-to-a-long-random-secret-shared-by-every-node

# ============================================================================================
# AI DAG generation (docs/design/ai-dag-generation.md). Off unless CRONFLOW_AI_ENABLED=true.
# Private-first: the default provider is a private Ollama endpoint. The OpenAI cloud is opt-in.
# ============================================================================================
CRONFLOW_AI_ENABLED=false
CRONFLOW_AI_DEFAULT_PROVIDER=ollama

# Private Ollama (or any OpenAI-compatible server: vLLM, LocalAI). base-url has no trailing /v1.
CRONFLOW_AI_OLLAMA_URL=http://your-ollama-host:21434
CRONFLOW_AI_OLLAMA_KEY=your-ollama-bearer-token
CRONFLOW_AI_OLLAMA_MODEL=qwen2.5-coder:7b

# OpenAI cloud (opt-in). allow-cloud MUST be true before this provider is usable (data leaves network).
OPENAI_API_KEY=
CRONFLOW_AI_OPENAI_MODEL=gpt-4o-mini
CRONFLOW_AI_OPENAI_ALLOW_CLOUD=false

# ============================================================================================
# Test-only (NOT read from this file by Spring). The extension DB tests take these as Maven system
# properties, e.g.  ./mvnw test -Dcronsmith.mysql.password=123456 -Dcronsmith.mysql.database=demo
# Listed here only so every knob is documented in one place.
#   cronsmith.mysql.host=localhost  port=3306  user=fengy  password=...  database=demo
#   cronsmith.pg.password=...
# The gated live tests read real env vars instead:
#   CRONFLOW_AI_LIVE=true  CRONFLOW_AI_OLLAMA_URL=...  CRONFLOW_AI_OLLAMA_KEY=...  (OllamaLiveSmokeTest)
#   CRONFLOW_AI_DB=true    CRONFLOW_AI_DB_URL/USER/PASS                           (JooqAiGenerationStoreDbTest)
