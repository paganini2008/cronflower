<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github.paganini2008</groupId>
	<artifactId>cronsmith-executor-spring-boot-starter</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>cronsmith-executor-spring-boot-starter</name>
	<description>Spring Boot starter for cronsmith executors: register @Task beans and run scheduler-dispatched jobs over HTTP, on either a servlet or reactive web stack.</description>
	<url>https://github.com/paganini2008/cronflower</url>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Fred Feng</name>
			<email>paganini.fy@gmail.com</email>
		</developer>
	</developers>
	<scm>
		<connection>https://github.com/paganini2008/cronflower.git</connection>
		<developerConnection>https://github.com/paganini2008/cronflower.git</developerConnection>
		<url>https://github.com/paganini2008/cronflower</url>
	</scm>
	<properties>
		<!-- JDK 17 or later. -->
		<java.version>17</java.version>
	</properties>
	<dependencies>
		<!-- An executor is stateless: it only needs a web endpoint and an HTTP client to talk
		     back to the server. No datasource, no ORM.

		     The endpoints are annotated @RestControllers, which BOTH Spring MVC and Spring WebFlux
		     serve, so the executor works whichever stack the host application uses. We depend only
		     on spring-webflux (not the webmvc starter): it brings spring-web for the controller
		     annotations and provides WebClient for the calls back to the server, without forcing a
		     servlet stack onto a reactive application. WebClient runs over the JDK HttpClient
		     connector, so no reactor-netty is pulled in. The host application supplies the actual
		     web server (spring-boot-starter-web or -webflux). -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webflux</artifactId>
		</dependency>
		<!-- Optional: when present, its /actuator/health is used as the liveness probe;
		     when absent, the starter falls back to its own /cronsmith/ping. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Tests only: JUnit 5, Mockito, AssertJ, spring-test (MockEnvironment,
		     ApplicationContextRunner, FilteredClassLoader). No datasource/ORM needed. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Tests only: a real executor application always has a JSON codec (via its web starter),
		     which the WebClient needs to encode request bodies. Spring's default client codecs use
		     Jackson 3 (tools.jackson); bring it in for the HTTP-path tests. -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Line-coverage report for the test suite: target/site/jacoco/index.html. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Attach the sources jar on package (required by Maven Central). Version managed by parent. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Attach a javadoc jar on package (required by Maven Central). Version managed by parent;
			     doclint off so non-conforming comments never fail the build. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<configuration>
					<doclint>none</doclint>
					<charset>UTF-8</charset>
					<encoding>UTF-8</encoding>
					<docencoding>UTF-8</docencoding>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- This module is a library (a starter), not an application: no repackage goal. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Activated only for a Central deploy: mvn -Prelease deploy
	     (kept out of the default build so a plain `mvn install` never GPG-signs or publishes).
	     maven-gpg-plugin version is managed by spring-boot-starter-parent. -->
	<profiles>
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<!-- GPG signing. Only required for a release; harmless for snapshots
					     (skip it with -Dgpg.skip=true on a pure snapshot push). -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<configuration>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
							</gpgArguments>
						</configuration>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.9.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<autoPublish>true</autoPublish>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<!-- Resolve the cronsmith engine snapshot from the Central Portal snapshot repo. -->
	<repositories>
		<repository>
			<id>central-portal-snapshots</id>
			<name>Central Portal Snapshots</name>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

</project>
