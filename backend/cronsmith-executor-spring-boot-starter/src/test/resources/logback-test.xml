<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <!-- The failover/degrade tests deliberately hit 500s; keep their expected warnings out of the log. -->
  <logger name="com.github.cronsmith.springapp.executor" level="ERROR"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
