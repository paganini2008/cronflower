<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>com.github.paganini2008</groupId>
	<artifactId>cronflow-server-api</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>cronflow-server-api</name>
	<description>Cronflow server (product): cronsmith scheduling + cronflow DAG, with login and role based authorization.</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.github.paganini2008</groupId>
			<artifactId>cronsmith-spring-boot-starter</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Optional DAG (cronflow) server: pluggable add-on. Remove it for a pure cronsmith server. -->
		<dependency>
			<groupId>com.github.paganini2008</groupId>
			<artifactId>cronflow-spring-boot-starter</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Health/metrics/info for the System Health page and executor liveness probes. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Login + role based authorization for the console API. Stateless JWT (bearer token) so any
		     node in the cluster accepts the same credentials behind the round-robin console proxy. The
		     oauth2-resource-server starter brings the Nimbus JOSE bits used to mint and verify the HMAC
		     tokens. Executor -> scheduler machine endpoints stay open (see SecurityConfig). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
		</dependency>
		<!-- Prometheus metrics for Grafana: exposes /actuator/prometheus for a scraper to pull. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Swagger UI / OpenAPI for the scheduler's REST API. The 3.x line targets Spring Boot 4 /
		     Spring Framework 7. Served at /swagger-ui.html and /v3/api-docs (outside the business
		     API prefix, which is scoped to the ...scheduler.web controllers only). -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.1.0</version>
		</dependency>
		<!-- JPA storage backend for this test: an embedded H2. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Present so the JOOQ storage tier can be exercised (backend=JOOQ). -->
		<dependency>
			<groupId>org.jooq</groupId>
			<artifactId>jooq</artifactId>
			<version>3.19.15</version>
		</dependency>
		<!-- Shared-database drivers for the multi-node / multi-database tests. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.46.1.3</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-community-dialects</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- SQL Server / Oracle drivers (JPA store on those dialects; jOOQ has no OSS dialect). -->
		<dependency>
			<groupId>com.microsoft.sqlserver</groupId>
			<artifactId>mssql-jdbc</artifactId>
			<version>12.8.1.jre11</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc11</artifactId>
			<version>23.7.0.25.01</version>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>cronflow-server-api-${project.version}</finalName>
		<!-- The jar ships ONLY the common application.properties. The per-environment profile files
		     (application-dev/prod.properties) stay in src/main/resources for LOCAL DEBUG (activate a
		     Spring profile in the IDE) but are excluded from the packaged jar; packaging is a separate,
		     independent path (see the maven-resources-plugin execution + the dev/prod profiles below,
		     which emit the active environment file as conf/server.properties). -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>application-dev.properties</exclude>
					<exclude>application-prod.properties</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Boot 4.1.1's default (new) fat-jar loader fails to load some nested-jar classes
					     (e.g. jakarta.servlet.ServletRequestWrapper during @RequestParam multipart
					     resolution), giving a 500 under `java -jar`; the app is fine when run exploded.
					     The CLASSIC loader avoids it. -->
					<loaderImplementation>CLASSIC</loaderImplementation>
				</configuration>
			</plugin>
			<!-- Packaging path (independent of the debug profiles above): emit the ACTIVE environment's
			     config as target/conf/server.properties. `mvn -Pdev` (default) -> application-dev.properties;
			     `mvn -Pprod` -> application-prod.properties. The deploy scripts stage this into
			     deploy/conf/server.properties and load it as the external override. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>emit-server-properties</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy file="${project.basedir}/src/main/resources/application-${deploy.env}.properties"
									tofile="${project.build.directory}/conf/server.properties"
									overwrite="true" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Build-time environment selection (independent of runtime Spring profiles). -->
		<profile>
			<id>dev</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<deploy.env>dev</deploy.env>
			</properties>
		</profile>
		<profile>
			<id>prod</id>
			<properties>
				<deploy.env>prod</deploy.env>
			</properties>
		</profile>
	</profiles>
</project>
