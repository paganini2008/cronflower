FROM eclipse-temurin:17-jre
# An example cronflower executor (hosts the demo @Task / @Dag beans). The fat jar is staged into
# bin/ by the GitHub Actions workflow. Optional: a real deployment hosts your own executor instead.
#
# SCRIPT tasks run in a per-run Docker container (copy-mode): the executor shells out to the `docker`
# CLI against the host daemon (mount /var/run/docker.sock at runtime), copies the script into a fresh
# container and runs it. So the image bundles a static docker CLI (per target arch). curl is added for
# the compose healthcheck. If this executor never runs SCRIPT tasks, the bundled docker CLI is unused.
ARG TARGETARCH
ARG DOCKER_VERSION=27.3.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
         amd64) DL_ARCH=x86_64 ;; \
         arm64) DL_ARCH=aarch64 ;; \
         *) DL_ARCH=x86_64 ;; \
       esac \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${DL_ARCH}/docker-${DOCKER_VERSION}.tgz" -o /tmp/docker.tgz \
    && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
    && install -m0755 /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker.tgz /tmp/docker
COPY bin/cronflow-executor-example-*.jar /app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app.jar"]
