<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>com.github.paganini2008</groupId>
	<artifactId>cronflow-executor-example</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>cronflow-executor-example</name>
	<description>Runnable cronflower executor (client) - cronsmith @Task showcase + optional cronflow DAG nodes</description>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencies>
		<!-- Servlet web stack: makes this a Spring MVC application. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Present, so the client should pick /actuator/health as the liveness probe. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- The starter under test. -->
		<dependency>
			<groupId>com.github.paganini2008</groupId>
			<artifactId>cronsmith-executor-spring-boot-starter</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Optional DAG (cronflow) executor: hosts workflow node beans. Pulls in cronsmith-executor. -->
		<dependency>
			<groupId>com.github.paganini2008</groupId>
			<artifactId>cronflow-executor-spring-boot-starter</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>cronflow-executor-example-${project.version}</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Boot 4.1.1's default fat-jar loader mis-loads some nested-jar classes under
					     `java -jar`; the CLASSIC loader avoids it (see scheduler-example pom). -->
					<loaderImplementation>CLASSIC</loaderImplementation>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
