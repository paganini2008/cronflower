# cronflower console configuration. Copy to `.env` and adjust; `npm start` / `npm run build` read it
# (via scripts/gen-config.mjs) to generate public/config.json, which the browser loads at runtime.
# Real environment variables (process.env) override values set here.

# THE MODE SWITCH. This one value decides how the console reaches the backend:
#   empty            -> same-origin: the standalone server.js (or the dev proxy) self-discovers the
#                       scheduler cluster and load-balances across it. No KONG/Nginx needed. (default)
#   a gateway origin -> the browser calls that URL directly (e.g. a KONG/Nginx that fronts the cluster);
#                       server.js then only serves the static SPA. Use this to slot in your own proxy.
# It is the extension point: point it at a gateway to opt out of the built-in balancing.
CF_API_BASE_URL=

# REST API prefixes — must match the backend (cronsmith.server.api-prefix / cronflow.server.api-prefix).
CF_API_PREFIX=/cronsmith
CF_CRONFLOW_PREFIX=/cronflow

# Demo login shown on the sign-in page. Not a security boundary (the browser can read it).
CF_AUTH_USER=admin
CF_AUTH_PASS=admin

# --- Cluster location (seeds) — used by BOTH the standalone server (server.mjs) AND the dev proxy.
# One or more seed schedulers, comma-separated. There is no fixed port: from any reachable seed's
# /actuator/health, server.mjs discovers the full member list (each member's real port from health
# metadata), load-balances with failover, and refreshes on a timer (nodes up/down auto-picked-up).
# The run-local / run-docker launchers inject every node's address here for you, so you normally leave
# this blank. Set it only for a manual run (e.g. `npm run serve` against a cluster you started
# yourself). For plain local debugging, http://localhost:19090 is the conventional single-node address.
CF_SEED_URL=

# --- Standalone console server (server.mjs) only ---
CF_WEB_PORT=7200
CF_WEB_ROOT=dist/cronflower/browser
CF_DISCOVERY_INTERVAL_MS=10000
