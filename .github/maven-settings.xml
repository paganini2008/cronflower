<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for CI. cronsmith and openspreader are published as SNAPSHOTs to the Central Portal
  snapshot repository, so this makes the GitHub Actions build resolve them the same way a local build
  does. The project poms also declare this repository, this is a belt-and-suspenders layer.
  Pass it with:  mvn -s .github/maven-settings.xml ...
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>central-portal-snapshots</id>
      <repositories>
        <repository>
          <id>central-portal-snapshots</id>
          <name>Central Portal Snapshots</name>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central-portal-snapshots</id>
          <name>Central Portal Snapshots</name>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>central-portal-snapshots</activeProfile>
  </activeProfiles>
</settings>
